<?xml version="1.0"?>
<rdf:RDF xmlns="http://dh.aks.ac.kr/ontologies/theater#"
     xml:base="http://dh.aks.ac.kr/ontologies/theater"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:theater="http://dh.aks.ac.kr/ontologies/theater#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:schoolsys="http://dh.aks.ac.kr/ontologies/personnelmatters/schoolsystem"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:ekc="http://dh.aks.ac.kr/ontologies/ekc#"
     xmlns:edm="http://www.europeana.eu/schemas/edm#">
    <owl:Ontology rdf:about="http://dh.aks.ac.kr/ontologies/theater"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://dh.aks.ac.kr/ontologies/ekc#participates -->

    <owl:ObjectProperty rdf:about="http://dh.aks.ac.kr/ontologies/ekc#participates">
        <rdfs:subPropertyOf rdf:resource="http://dh.aks.ac.kr/ontologies/ekc#performed"/>
        <rdfs:domain rdf:resource="http://dh.aks.ac.kr/ontologies/theater#Agent"/>
        <rdfs:range rdf:resource="http://dh.aks.ac.kr/ontologies/theater#Performance"/>
        <rdfs:range rdf:resource="http://dh.aks.ac.kr/ontologies/theater#Work"/>
        <rdfs:comment xml:lang="kr">A는 B에 참여했다
인물/단체와 공연을 연결키시는 상위 프로퍼티이다. 공연에 관여한 인물/단체를 모두 서술한다.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://dh.aks.ac.kr/ontologies/ekc#performed -->

    <owl:ObjectProperty rdf:about="http://dh.aks.ac.kr/ontologies/ekc#performed">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://dh.aks.ac.kr/ontologies/theater#Agent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="kr">A는 B를 수행하였다
인물/단체와 개념을 연결시키는 프로퍼티로서, 인물/단체가 사건을 수행하였음을 서술한다.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://dh.aks.ac.kr/ontologies/personnelmatters/schoolsystemhasEventObject -->

    <owl:ObjectProperty rdf:about="http://dh.aks.ac.kr/ontologies/personnelmatters/schoolsystemhasEventObject">
        <rdfs:domain rdf:resource="http://dh.aks.ac.kr/ontologies/theater#Event"/>
        <rdfs:range rdf:resource="http://dh.aks.ac.kr/ontologies/theater#Agent"/>
    </owl:ObjectProperty>
    


    <!-- http://dh.aks.ac.kr/ontologies/personnelmatters/schoolsystemhasEventPostObject -->

    <owl:ObjectProperty rdf:about="http://dh.aks.ac.kr/ontologies/personnelmatters/schoolsystemhasEventPostObject">
        <rdfs:domain rdf:resource="http://dh.aks.ac.kr/ontologies/theater#Event"/>
        <rdfs:range rdf:resource="http://dh.aks.ac.kr/ontologies/theater#Document"/>
        <rdfs:range rdf:resource="http://dh.aks.ac.kr/ontologies/theater#Event"/>
    </owl:ObjectProperty>
    


    <!-- http://dh.aks.ac.kr/ontologies/personnelmatters/schoolsystemhasEventPreObject -->

    <owl:ObjectProperty rdf:about="http://dh.aks.ac.kr/ontologies/personnelmatters/schoolsystemhasEventPreObject">
        <rdfs:domain rdf:resource="http://dh.aks.ac.kr/ontologies/theater#Event"/>
        <rdfs:range rdf:resource="http://dh.aks.ac.kr/ontologies/theater#Document"/>
        <rdfs:range rdf:resource="http://dh.aks.ac.kr/ontologies/theater#Event"/>
    </owl:ObjectProperty>
    


    <!-- http://dh.aks.ac.kr/ontologies/personnelmatters/schoolsystemhasEventType -->

    <owl:ObjectProperty rdf:about="http://dh.aks.ac.kr/ontologies/personnelmatters/schoolsystemhasEventType">
        <rdfs:domain rdf:resource="http://dh.aks.ac.kr/ontologies/theater#Event"/>
        <rdfs:range rdf:resource="http://dh.aks.ac.kr/ontologies/theater#Concept"/>
    </owl:ObjectProperty>
    


    <!-- http://dh.aks.ac.kr/ontologies/theater#chargeOfMusicIn -->

    <owl:ObjectProperty rdf:about="http://dh.aks.ac.kr/ontologies/theater#chargeOfMusicIn">
        <rdfs:subPropertyOf rdf:resource="http://dh.aks.ac.kr/ontologies/ekc#participates"/>
        <owl:inverseOf rdf:resource="http://dh.aks.ac.kr/ontologies/theater#hasMusicDirector"/>
        <rdfs:domain rdf:resource="http://dh.aks.ac.kr/ontologies/theater#Agent"/>
        <rdfs:range rdf:resource="http://dh.aks.ac.kr/ontologies/theater#Performance"/>
        <rdfs:comment xml:lang="kr">A는 B의 음악담당이다
인물/단체와 공연을 연결시키는 프로퍼티로서, 인물이 공연에서 음악 담당인 것을 서술한다.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://dh.aks.ac.kr/ontologies/theater#create -->

    <owl:ObjectProperty rdf:about="http://dh.aks.ac.kr/ontologies/theater#create">
        <rdfs:subPropertyOf rdf:resource="http://dh.aks.ac.kr/ontologies/ekc#performed"/>
        <owl:inverseOf rdf:resource="http://dh.aks.ac.kr/ontologies/theater#isCreatedBy"/>
        <rdfs:domain rdf:resource="http://dh.aks.ac.kr/ontologies/theater#Agent"/>
        <rdfs:range rdf:resource="http://dh.aks.ac.kr/ontologies/theater#Document"/>
        <rdfs:range rdf:resource="http://dh.aks.ac.kr/ontologies/theater#Performance"/>
        <rdfs:range rdf:resource="http://dh.aks.ac.kr/ontologies/theater#Work"/>
        <rdfs:comment xml:lang="kr">A가 B를 창작한다
인물/단체와 공연을 연결시키는 프로퍼티로서, 인물/단체가 공연을 창작한 것을 서술한다.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://dh.aks.ac.kr/ontologies/theater#eventBasedOn -->

    <owl:ObjectProperty rdf:about="http://dh.aks.ac.kr/ontologies/theater#eventBasedOn">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://dh.aks.ac.kr/ontologies/theater#Event"/>
        <rdfs:range rdf:resource="http://dh.aks.ac.kr/ontologies/theater#Concept"/>
        <rdfs:range rdf:resource="http://dh.aks.ac.kr/ontologies/theater#Document"/>
        <rdfs:comment xml:lang="kr">A는 B를 근거로 한다
사건과 개념을 연결시키는 프로퍼티로서, 사건에 개념이 근거가 있음을 서술한다.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://dh.aks.ac.kr/ontologies/theater#generated -->

    <owl:ObjectProperty rdf:about="http://dh.aks.ac.kr/ontologies/theater#generated">
        <rdfs:subPropertyOf rdf:resource="http://dh.aks.ac.kr/ontologies/theater#hasPerformanceDefines"/>
        <owl:inverseOf rdf:resource="http://dh.aks.ac.kr/ontologies/theater#isGeneratedBy"/>
        <rdfs:domain rdf:resource="http://dh.aks.ac.kr/ontologies/theater#Work"/>
        <rdfs:range rdf:resource="http://dh.aks.ac.kr/ontologies/theater#Performance"/>
        <rdfs:range rdf:resource="http://dh.aks.ac.kr/ontologies/theater#Work"/>
    </owl:ObjectProperty>
    


